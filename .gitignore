# Dependencias de paquetes
node_modules/

# Sesión activa de WhatsApp y perfiles de Chromium (datos voluminosos y credenciales locales)
Seccion/*
!Seccion/.gitkeep

# Caché interna de WhatsApp Web
.wwebjs_cache/
.wwebjs_auth/

# Caché de ejecución del bot
cache/*
!cache/.gitkeep

# Directorio temporal de pruebas
scratch/

# Archivos temporales y de registro
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
